APP_ENV=development
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
INITIAL_EMPLOYEE_PASSWORD=
INITIAL_MANAGER_PASSWORD=
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///./data/app.db
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_INPUT_COST_PER_1M=
LLM_OUTPUT_COST_PER_1M=
OTEL_EXPORTER_OTLP_ENDPOINT=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_TOP_K=5
BM25_TOP_K=5
RERANK_TOP_K=5
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CACHE_TTL_SECONDS=300
CACHE_ENABLED=true
EVIDENCE_MIN_SCORE=0.15
RERANK_MIN_SCORE=-8.0
RAW_DOCUMENTS_DIR=data/raw
UPLOADED_DOCUMENTS_DIR=data/uploads
INDEX_DIR=data/index
